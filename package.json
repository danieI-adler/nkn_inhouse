{
  "name": "nkn-inhouse-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "node start-all.js",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:bot": "npm --workspace=apps/bot run dev",
    "dev:web": "npm --workspace=apps/web-draft run dev"
  }
}
